# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
.vercel/

# Production
build/
dist/

# Production standalone server (generated by next build)
server.log

# Local database (SQLite) — never commit the dev DB
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Prisma generated client (regenerated on every install/build)
prisma/migrations/dev.db*

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep the .env.example committed
!.env.example

# Uploaded media (user-generated content — must live in object storage in production)
public/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Tooling artifacts
tool-results/
download/
upload/

# QA screenshots (kept locally, not committed)
qa-*.png

# Test artifacts
coverage/
.nyc_output/

# Misc
*.tsbuildinfo
next-env.d.ts
