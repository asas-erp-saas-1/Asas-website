# ASAS Production environment
# NEVER commit real values. Set these in Vercel Project Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prisma database URL. Vercel/Supabase may provide POSTGRES_PRISMA_URL or POSTGRES_URL;
# src/lib/env.ts accepts those as fallbacks.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=
