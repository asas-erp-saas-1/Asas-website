generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  nameAr String? @map("name_ar")
  tagline String?
  taglineAr String? @map("tagline_ar")
  description String? @db.Text
  descriptionAr String? @map("description_ar") @db.Text
  city String?
  cityAr String? @map("city_ar")
  district String?
  districtAr String? @map("district_ar")
  address String?
  addressAr String? @map("address_ar")
  latitude Float?
  longitude Float?
  projectType String? @default("RESIDENTIAL") @map("project_type")
  status String @default("active")
  featured Boolean @default(false)
  startingPrice Decimal? @map("starting_price")
  deliveryDate DateTime? @map("delivery_date") @db.Date
  heroMediaId String? @map("hero_media_id") @db.Uuid
  heroImage String? @map("hero_image")
  images String?
  apartmentTypes Json? @default("[]") @map("apartment_types")
  minSurface Int? @map("min_surface")
  maxSurface Int? @map("max_surface")
  deliveryYear Int? @map("delivery_year")
  deliveryQuarter String? @map("delivery_quarter")
  hasParking Boolean? @default(false) @map("has_parking")
  hasElevator Boolean? @default(false) @map("has_elevator")
  hasGarden Boolean? @default(false) @map("has_garden")
  hasPool Boolean? @default(false) @map("has_pool")
  hasSecurity Boolean? @default(false) @map("has_security")
  hasClim Boolean? @default(false) @map("has_clim")
  priceOnRequest Boolean? @default(false) @map("price_on_request")
  developerId String? @map("developer_id") @db.Uuid
  published Boolean @default(true)
  archived Boolean @default(false)
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords String? @map("seo_keywords") @db.Text
  canonicalUrl String? @map("canonical_url")
  ogImage String? @map("og_image")
  robotsIndex Boolean @default(true) @map("robots_index")
  order Int? @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  developer Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  buildings Building[]
  apartments Apartment[]
  amenities ProjectAmenity[]
  imagesRelation ProjectImage[] @relation("ProjectImages")
  videos Video[]

  @@index([published])
  @@index([archived])
  @@index([developerId])
  @@map("projects")
}

model Building {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  projectId String @map("project_id") @db.Uuid
  name String
  nameAr String? @map("name_ar")
  code String
  floors Int
  hasElevator Boolean @default(false) @map("has_elevator")
  order Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartments Apartment[]
  @@index([projectId])
  @@map("buildings")
}

model Apartment {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  slug String
  apartmentNumber String @map("apartment_number")
  unitNumber String? @map("unit_number")
  type String?
  apartmentType String? @default("F3") @map("apartment_type")
  typeName String @map("type_name")
  typeNameAr String? @map("type_name_ar")
  surface Decimal?
  floor Int?
  totalFloors Int? @map("total_floors")
  orientation String?
  bedrooms Int?
  bathrooms Int?
  parking Boolean @default(false)
  balcony Boolean @default(false)
  balconies Int?
  balconySurface Int? @map("balcony_surface")
  hasParking Boolean? @default(false) @map("has_parking")
  parkingSpots Int? @map("parking_spots")
  hasTerrace Boolean @default(false) @map("has_terrace")
  terraceSurface Int? @map("terrace_surface")
  hasGarden Boolean @default(false) @map("has_garden")
  gardenSurface Int? @map("garden_surface")
  status String @default("available")
  price Decimal?
  priceOnRequest Boolean? @default(false) @map("price_on_request")
  paymentPlan String? @map("payment_plan")
  paymentPlanAr String? @map("payment_plan_ar")
  floorPlanImage String? @map("floor_plan_image")
  furnishedPlanImage String? @map("furnished_plan_image")
  renderImage String? @map("render_image")
  images String?
  rooms Json?
  description String? @db.Text
  descriptionAr String? @map("description_ar") @db.Text
  features Json?
  featuresAr Json? @map("features_ar")
  published Boolean @default(true)
  archived Boolean @default(false)
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords String? @map("seo_keywords") @db.Text
  canonicalUrl String? @map("canonical_url")
  ogImage String? @map("og_image")
  robotsIndex Boolean @default(true) @map("robots_index")
  order Int? @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  imagesRelation ApartmentImage[] @relation("ApartmentImages")
  videos Video[]

  @@index([projectId])
  @@index([buildingId])
  @@index([status])
  @@index([published])
  @@unique([projectId, apartmentNumber])
  @@unique([projectId, slug])
  @@map("apartments")
}

model ProjectImage {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  url String
  alt String?
  altAr String? @map("alt_ar")
  caption String?
  captionAr String? @map("caption_ar")
  type String @default("gallery")
  order Int @default(0) @map("sort_order")
  width Int?
  height Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation("ProjectImages", fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
  @@index([type])
  @@map("project_images")
}

model ApartmentImage {
  id String @id @default(uuid()) @db.Uuid
  apartmentId String @map("apartment_id") @db.Uuid
  url String
  alt String?
  altAr String? @map("alt_ar")
  caption String?
  captionAr String? @map("caption_ar")
  type String @default("gallery")
  order Int @default(0) @map("sort_order")
  width Int?
  height Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  apartment Apartment @relation("ApartmentImages", fields: [apartmentId], references: [id], onDelete: Cascade)
  @@index([apartmentId])
  @@index([type])
  @@map("apartment_images")
}

model Developer {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  nameAr String? @map("name_ar")
  description String? @db.Text
  descriptionAr String? @map("description_ar") @db.Text
  logo String?
  website String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  projects Project[]
  @@map("developers")
}

model ProjectAmenity {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name String
  nameAr String? @map("name_ar")
  icon String?
  description String? @db.Text
  descriptionAr String? @map("description_ar") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
  @@map("project_amenities")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  name String
  phone String?
  email String?
  preferredContact String? @map("preferred_contact")
  intent String?
  message String? @db.Text
  projectId String? @map("project_id") @db.Uuid
  projectName String? @map("project_name")
  apartmentId String? @map("apartment_id") @db.Uuid
  apartmentName String? @map("apartment_name")
  pageUrl String? @map("page_url")
  landingPage String? @map("landing_page")
  utmSource String? @map("utm_source")
  utmMedium String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent String? @map("utm_content")
  utmTerm String? @map("utm_term")
  gclid String?
  fbclid String?
  referrer String?
  source String?
  status String @default("new")
  assignedTo String? @map("assigned_to")
  followUpDate DateTime? @map("follow_up_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  notes LeadNote[]
  @@index([status])
  @@index([createdAt])
  @@index([projectId])
  @@index([apartmentId])
  @@map("leads")
}

model SiteContent {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  value String @db.Text
  valueAr String? @map("value_ar") @db.Text
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("site_content")
}

model NewsletterSubscription {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  source String?
  locale String?
  pageUrl String? @map("page_url")
  utmSource String? @map("utm_source")
  utmMedium String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  status String @default("SUBSCRIBED")
  confirmedAt DateTime? @map("confirmed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscriptions")
}

model AdminUser {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String @map("password_hash")
  role String @default("ADMIN")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  sessions AdminSession[]
  @@map("admin_users")
}

model AdminSession {
  id String @id @default(uuid()) @db.Uuid
  token String @unique
  userId String @map("user_id") @db.Uuid
  email String
  name String
  role String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Video {
  id String @id @default(uuid()) @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  apartmentId String? @map("apartment_id") @db.Uuid
  url String?
  storagePath String? @map("storage_path")
  thumbnailUrl String? @map("thumbnail_url")
  title String
  description String? @db.Text
  type String @default("GALLERY")
  featured Boolean @default(false)
  order Int @default(0) @map("display_order")
  published Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  @@index([projectId])
  @@index([apartmentId])
  @@map("videos")
}

model LeadNote {
  id String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  authorEmail String? @map("author_email")
  body String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
  @@index([createdAt])
  @@map("lead_notes")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorEmail String? @map("actor_email")
  actorRole String? @map("actor_role")
  action String
  entityType String? @map("entity_type")
  entityId String? @map("entity_id")
  entitySlug String? @map("entity_slug")
  before Json?
  after Json?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([actorEmail])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginRateLimit {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  count Int @default(0)
  windowStart DateTime @map("window_start")
  lockedUntil DateTime? @map("locked_until")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([lockedUntil])
  @@index([updatedAt])
  @@map("login_rate_limits")
}