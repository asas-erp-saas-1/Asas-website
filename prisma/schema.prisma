generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Core Enums (enforced at app layer, SQLite has no enum type) ───
// ProjectStatus: AVAILABLE | COMING_SOON | SOLD_OUT | DRAFT
// ApartmentStatus: AVAILABLE | RESERVED | SOLD | COMING_SOON | OFF_MARKET | DRAFT
// ProjectType: RESIDENTIAL | MIXED_USE | COMMERCIAL
// ApartmentType: F2 | F3 | F4 | F5 | Duplex | Studio | Villa
// ImageType: hero | gallery | floor-plan | 3d-plan | interior | exterior | view | document | amenity
// PublishStatus: DRAFT | PUBLISHED | ARCHIVED

// ─── Project ──────────────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameAr      String?
  tagline     String?
  taglineAr   String?
  description String?
  descriptionAr String?

  // Location
  city        String
  cityAr      String?
  district    String
  districtAr  String?
  address     String?
  addressAr   String?
  latitude    Float?
  longitude   Float?

  // Project details
  projectType String   @default("RESIDENTIAL") // RESIDENTIAL, MIXED_USE, COMMERCIAL
  status      String   @default("AVAILABLE")   // AVAILABLE, COMING_SOON, SOLD_OUT, DRAFT

  // Apartment types available (JSON array)
  apartmentTypes String @default("[]")

  // Surfaces
  minSurface Int?
  maxSurface Int?

  // Delivery
  deliveryYear    Int?
  deliveryQuarter String? // Q1, Q2, Q3, Q4

  // Features
  hasParking    Boolean @default(false)
  hasElevator   Boolean @default(false)
  hasGarden     Boolean @default(false)
  hasPool       Boolean @default(false)
  hasSecurity   Boolean @default(false)
  hasClim       Boolean @default(false)

  // Commercial
  startingPrice Int?
  priceOnRequest Boolean @default(false)

  // Developer
  developerId   String?
  developer     Developer? @relation(fields: [developerId], references: [id])

  // Publish workflow
  published   Boolean  @default(false) // false = DRAFT, true = PUBLISHED
  archived    Boolean  @default(false)

  // SEO metadata (per-entity overrides)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?  // comma-separated
  canonicalUrl     String?
  ogImage          String?  // URL (relative or absolute)
  robotsIndex      Boolean  @default(true) // false = noindex

  // Meta
  featured    Boolean  @default(false)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildings   Building[]
  apartments  Apartment[]
  amenities   ProjectAmenity[]
  images      ProjectImage[]
  videos      Video[]
}

// ─── Building ─────────────────────────────────────────────────────
// Supports the hierarchy: Project → Building → Apartment
model Building {
  id          String   @id @default(cuid())
  slug        String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String   // e.g. "Bâtiment A", "Tour Nord"
  nameAr      String?
  code        String   // e.g. "A", "B", "NORD"
  floors      Int      // Total number of floors
  hasElevator Boolean  @default(false)

  // Meta
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apartments  Apartment[]
}

// ─── Apartment ────────────────────────────────────────────────────
model Apartment {
  id          String   @id @default(cuid())
  slug        String   @unique
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  // Identity
  unitNumber    String?  // e.g. "A-101"
  apartmentType String   @default("F3") // F2, F3, F4, F5, Duplex, Studio, Villa
  typeName      String   // e.g. "F3 Familial"
  typeNameAr    String?

  // Specifications
  surface       Int      // m²
  floor         Int?
  totalFloors   Int?
  orientation   String?  // Nord, Sud, Est, Ouest, Nord-Est, Nord-Ouest, Sud-Est, Sud-Ouest
  bedrooms      Int
  bathrooms     Int?
  balconies     Int?
  balconySurface Int?   // m²
  hasParking    Boolean  @default(false)
  parkingSpots  Int?
  hasTerrace    Boolean  @default(false)
  terraceSurface Int?   // m²
  hasGarden     Boolean  @default(false)
  gardenSurface Int?    // m²

  // Status — ONE source of truth
  status      String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD, COMING_SOON, OFF_MARKET, DRAFT

  // Commercial
  price         Int?
  priceOnRequest Boolean @default(false)
  paymentPlan   String?
  paymentPlanAr String?

  // Room breakdown (JSON)
  rooms       String? // JSON: [{name:"Salon", nameAr:"صالون", surface:25}, ...]

  // Description
  description   String?
  descriptionAr String?

  // Features (JSON array of feature strings)
  features      String? // JSON: ["Climatisation", "Double vitrage", ...]
  featuresAr    String? // JSON: ["تكييف", "زجاج مزدوج", ...]

  // Publish workflow
  published   Boolean  @default(false) // false = DRAFT, true = PUBLISHED
  archived    Boolean  @default(false)

  // SEO metadata (per-entity overrides)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  ogImage          String?
  robotsIndex      Boolean  @default(true)

  // Meta
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      ApartmentImage[]
  videos      Video[]
}

// ─── Structured Image Models ──────────────────────────────────────
// Images are first-class entities with type, order, alt, caption

model ProjectImage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url         String   // URL or path to image
  alt         String?  // Accessibility alt text
  altAr       String?  // Arabic alt text
  caption     String?  // Optional caption
  captionAr   String?
  type        String   @default("gallery") // hero, gallery, exterior, interior, amenity, document, architecture
  order       Int      @default(0)
  width       Int?     // Original width in px
  height      Int?     // Original height in px

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([type])
}

model ApartmentImage {
  id          String   @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  url         String
  alt         String?
  altAr       String?
  caption     String?
  captionAr   String?
  type        String   @default("gallery") // hero, gallery, floor-plan, 3d-plan, interior, exterior, view, document
  order       Int      @default(0)
  width       Int?
  height      Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([apartmentId])
  @@index([type])
}

// ─── Developer ────────────────────────────────────────────────────
model Developer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameAr      String?
  description String?
  descriptionAr String?
  logo        String?
  website     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]
}

// ─── Project Amenity ──────────────────────────────────────────────
model ProjectAmenity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  icon        String?  // Lucide icon name
  description String?
  descriptionAr String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// ─── Lead ─────────────────────────────────────────────────────────
model Lead {
  id          String   @id @default(cuid())

  // Contact
  name        String
  phone       String
  email       String?
  preferredContact String? // PHONE, WHATSAPP, EMAIL
  intent      String   // REQUEST_INFORMATION, REQUEST_PRICE, REQUEST_FLOOR_PLAN, BOOK_VISIT, WHATSAPP, CALL, RESERVATION
  message     String?

  // Context (auto-filled)
  projectId   String?
  projectName String?
  apartmentId String?
  apartmentName String?
  pageUrl     String?
  landingPage String?

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  gclid       String?
  fbclid      String?
  referrer    String?

  // Meta
  source      String?  // WEBSITE, WHATSAPP, PHONE, FORM
  // Extended pipeline: NEW → CONTACTED → QUALIFIED → VISIT → NEGOTIATION → SOLD → LOST
  status      String   @default("NEW")
  assignedTo  String?  // AdminUser email (denormalized for fast display)
  followUpDate DateTime?

  // Relations
  notes       LeadNote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Site Content (CMS key-value store) ──────────────────────────
model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "hero_title", "about_mission"
  value       String
  valueAr     String?

  updatedAt   DateTime @updatedAt
}

// ─── Newsletter ──────────────────────────────────────────────────
model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String?  // FOOTER, POPUP, CAMPAIGN, etc.
  locale      String?  // fr, ar
  pageUrl     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      String   @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, BOUNCED
  confirmedAt DateTime?
  unsubscribedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Admin User (lightweight auth for CMS) ───────────────────────
model AdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  passwordHash String
  role        String   @default("ADMIN") // ADMIN, EDITOR, VIEWER
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    AdminSession[]
}

// ─── Admin Session (DB-backed auth sessions) ─────────────────────
// Solves the multi-instance serverless problem: in-memory Map sessions
// break when Vercel scales to >1 lambda instance (login on instance A
// → next request hits instance B → 401). DB-backed sessions persist
// across instances. Falls back to in-memory Map in dev (no DB round-trip
// per request) when ADMIN_SESSION_DRIVER=memory.
model AdminSession {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String   // denormalized for fast display
  name        String
  role        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?  // null = active, set on logout

  @@index([userId])
  @@index([expiresAt])
}

// ─── Video (project + apartment videos) ──────────────────────────
// Stores either an external URL (YouTube/Vimeo) or a relative path
// to an uploaded file under /uploads/videos/...
model Video {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  // Either url (external) OR storagePath (uploaded) is set
  url           String?  // e.g. https://www.youtube.com/watch?v=xxx or https://vimeo.com/xxx
  storagePath   String?  // /uploads/videos/project-slug/xxx.mp4
  thumbnailUrl String?

  title         String
  description   String?
  type          String   @default("GALLERY") // HERO, GALLERY, WALKTHROUGH, INTERVIEW
  featured      Boolean  @default(false)
  order         Int      @default(0)
  published     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([apartmentId])
}

// ─── Lead Note (follow-up notes per lead) ──────────────────────────
model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorEmail String?  // AdminUser email who wrote the note
  body        String
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ─── Audit Log (tracks admin mutations) ───────────────────────────
// Single source of truth for "who did what, when, to what".
model AuditLog {
  id          String   @id @default(cuid())
  actorEmail  String?  // AdminUser email (null if unauthenticated)
  actorRole   String?  // ADMIN/EDITOR/VIEWER
  action      String   // LOGIN, LOGOUT, LOGIN_FAILED, CREATE_PROJECT, UPDATE_PROJECT,
                       // ARCHIVE_PROJECT, CREATE_APARTMENT, UPDATE_APARTMENT,
                       // ARCHIVE_APARTMENT, UPDATE_APARTMENT_STATUS, CREATE_BUILDING,
                       // UPLOAD_MEDIA, DELETE_MEDIA, UPDATE_MEDIA, CREATE_VIDEO,
                       // UPDATE_VIDEO, DELETE_VIDEO, UPDATE_LEAD_STATUS, CREATE_LEAD_NOTE,
                       // CREATE_USER, UPDATE_USER, DEACTIVATE_USER, PRICE_CHANGE
  entityType  String?  // Project, Apartment, ProjectImage, ApartmentImage, Video, Lead, AdminUser
  entityId    String?  // id of the entity affected
  entitySlug  String?  // slug for quick identification
  // Before/after payload (JSON-serialized string for diff)
  before      String?
  after       String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}


// ─── Login rate limiting (serverless-safe) ─────────────────────────
model LoginRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
  @@index([updatedAt])
}
